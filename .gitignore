# Theo dõi mã và tài liệu trong code/, launcher trong Chay CT/.
# Dữ liệu và file nhị phân không đưa vào git: file Excel không diff được và
# làm repo phình rất nhanh.

# Dữ liệu nghiệp vụ, workbook nguồn và mọi artifact ETL không thuộc source code.
# Các file đã tracked trước đây vẫn còn cho tới khi có kế hoạch purge riêng;
# quy tắc này ngăn dữ liệu mới bị add lại sau khi được di chuyển khỏi Git.
/Data/
/web/data/

# Workbook rời ở gốc dự án
/Chiet khau tra sau/

# Cau hinh dich Drive rieng cua tung may
/Chay CT/drive.conf

# rclone.exe tai ve
/.runtime/rclone/

# Thư mục nháp của agent và runtime cục bộ
/.codex_work/
/.runtime/
node_modules/
.pytest_cache/
.coverage
htmlcov/

# File thực thi đóng gói
code/Skill/sell-in-monthly/assets/portable/*.exe

# Thư viện vendored
code/Skill/skill-bao-cao/scripts/vendor/

