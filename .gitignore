# Theo dõi mã và tài liệu trong code/, launcher trong Chay CT/.
# Dữ liệu và file nhị phân không đưa vào git: file Excel không diff được và
# làm repo phình rất nhanh.

# Du lieu staging cho bao cao
!/Data/Work/bao_cao/
/Data/Logs/
/Data/out put/
/Data/Work/sell_in/

# Workbook rời ở gốc dự án: dữ liệu, không phải mã chạy. Chưa có script nào đọc
# nên tạm để nguyên chỗ cũ; nếu sau này đưa vào quy trình thì chuyển vào /Data/.
/Chiet khau tra sau/

# Cau hinh dich Drive rieng cua tung may. Thuong khong can, vi thu muc dung
# chung da la mac dinh trong code; ai tao file nay la dang doi dich cho rieng may
# do nen khong commit. Ban mau drive.conf.example thi van theo doi.
/Chay CT/drive.conf

# rclone.exe tai ve: file nhi phan ben thu ba, moi may tu tai.
/.runtime/rclone/

# Thư mục nháp của agent và runtime cục bộ
/.codex_work/
/.runtime/
node_modules/

# File thực thi đóng gói: dựng lại bằng scripts/build_portable.ps1
code/Skill/sell-in-monthly/assets/portable/*.exe

# Thư viện vendored: khôi phục bằng pip install openpyxl
code/Skill/skill-bao-cao/scripts/vendor/

# Rác của Python và Excel
__pycache__/
*.py[cod]
~$*
*.tmp
.*.tmp.xlsx

# Rác của hệ điều hành
Thumbs.db
desktop.ini
.DS_Store
