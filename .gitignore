# làm repo phình rất nhanh.

# Dữ liệu nghiệp vụ, workbook nguồn và mọi artifact ETL không thuộc source code.
/Data/
/web/data/

# Workbook rời ở gốc dự án
/Chiet khau tra sau/

# Cấu hình đích Drive riêng của từng máy
/Chay CT/drive.conf

# Runtime/tool cache cục bộ
/.runtime/
/.codex_work/
node_modules/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# File thực thi đóng gói
code/Skill/sell-in-monthly/assets/portable/*.exe

# Thư viện vendored local
code/Skill/skill-bao-cao/scripts/vendor/

