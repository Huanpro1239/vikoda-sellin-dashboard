# VIKODA SELL-IN DASHBOARD - ENVIRONMENT VARIABLES TEMPLATE
# Sao chép file này thành .env và điền các giá trị thực tế (Không commit .env lên Git)

# 1. MICROSOFT AZURE AD / ENTRA ID (Cho đồng bộ SharePoint tự động qua Microsoft Graph API)
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_app_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_value_here
SHAREPOINT_SITE_ID=your_sharepoint_site_id_here
SHAREPOINT_DRIVE_ID=your_sharepoint_drive_id_here

# 2. POWER AUTOMATE CLOUD WEBHOOK (Tùy chọn tải file lên SharePoint)
POWER_AUTOMATE_UPLOAD_WEBHOOK=

# 3. ĐƯỜNG DẪN CỤC BỘ (Tùy chọn ghi đè đường dẫn OneDrive trên máy cá nhân)
# VIKODA_ONEDRIVE_PATH=D:/onedrive/Vikoda/Planning - Vikoda_Sales_Data
