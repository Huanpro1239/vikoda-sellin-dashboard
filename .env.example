# VIKODA SELL-IN DASHBOARD - ENVIRONMENT VARIABLES TEMPLATE
# Sao chép file này thành .env khi chạy local nếu cần cấu hình đường dẫn.
# KHÔNG commit .env hoặc token thật lên Git.

# 1. MICROSOFT ENTRA ID / GITHUB OIDC
# Hai ID này KHÔNG phải mật khẩu. Trên GitHub nên lưu dưới Repository Variables.
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_app_client_id_here

# Cloud workflow KHÔNG dùng AZURE_CLIENT_SECRET.
# GitHub Actions đăng nhập bằng OIDC + Federated Credential.
# Khi test local, đăng nhập Azure CLI trước:
# az login --tenant <AZURE_TENANT_ID> --allow-no-subscriptions

# Hai ID SharePoint dưới đây là tùy chọn. code/common/sharepoint_bootstrap.py tự resolve.
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

SHAREPOINT_HOSTNAME=vikodacomvn.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Planning

# 2. CẤU TRÚC THƯ MỤC SHAREPOINT
# Shared Documents/Vikoda_Sales_Data/
#   Data ERP/
#   Target/
#   DanhMuc_KH/
#   DanhMuc_SP/
#   Data_Goc/
SHAREPOINT_BASE_FOLDER=Vikoda_Sales_Data

# 3. LOCAL FALLBACK QUA ONEDRIVE SYNC
# PowerShell watcher có thể đọc VIKODA_ONEDRIVE_PATH nếu cần chạy trên Windows.
# Ví dụ:
# setx VIKODA_ONEDRIVE_PATH "D:\\onedrive\\Vikoda\\Planning - Vikoda_Sales_Data"
