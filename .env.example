# VIKODA SELL-IN DASHBOARD - ENVIRONMENT VARIABLES TEMPLATE
# Sao chép file này thành .env khi chạy local và điền giá trị thực tế.
# KHÔNG commit .env hoặc secret thật lên Git.

# 1. MICROSOFT ENTRA ID / MICROSOFT GRAPH
# Dùng cho GitHub Actions hoặc chạy cloud trực tiếp với SharePoint.
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_app_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_value_here

# Hai ID dưới đây là tùy chọn. code/common/sharepoint_bootstrap.py có thể tự resolve.
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Có thể dùng để tự resolve site/drive khi hai ID trên để trống.
SHAREPOINT_HOSTNAME=vikodacomvn.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Planning

# 2. THƯ MỤC SHAREPOINT
SHAREPOINT_ERP_FOLDER=Data ERP
SHAREPOINT_TARGET_FOLDER=Target
SHAREPOINT_CUSTOMER_FOLDER=Danh muc KH
SHAREPOINT_PRODUCT_FOLDER=Danh muc SP

# 3. CHẾ ĐỘ LOCAL MIỄN PHÍ QUA ONEDRIVE SYNC
# PowerShell watcher đọc biến môi trường Windows VIKODA_ONEDRIVE_PATH.
# Ví dụ thiết lập một lần bằng CMD:
# setx VIKODA_ONEDRIVE_PATH "D:\onedrive\Vikoda\Planning - Vikoda_Sales_Data"
#
# Power Automate HTTP webhook không còn là cấu hình bắt buộc của project.
