# VIKODA SELL-IN DATA PLATFORM - ENVIRONMENT TEMPLATE
# Không commit .env, access token hoặc production data vào Git.

# Microsoft Entra / GitHub OIDC identifiers for SharePoint Graph access.
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_app_client_id_here
# Production workflow không dùng AZURE_CLIENT_SECRET.

# Optional IDs. sharepoint_bootstrap.py tự resolve nếu để trống.
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# SharePoint contract
SHAREPOINT_HOSTNAME=vikodacomvn.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Planning
SHAREPOINT_BASE_FOLDER=Vikoda_Sales_Data
SHAREPOINT_PIPELINE_STATE_FILE=_vikoda_pipeline_state.json
SHAREPOINT_INCREMENTAL_STATE_FILE=_vikoda_incremental_state.json

# GitHub Pages dùng GitHub Actions native deployment.
# Không cần deployment token hoặc biến hosting riêng.

# Local Windows fallback only
# VIKODA_ONEDRIVE_PATH=D:\\onedrive\\Vikoda\\Planning - Vikoda_Sales_Data
