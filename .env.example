# VIKODA SELL-IN - ENVIRONMENT VARIABLES TEMPLATE
# Sao chép thành .env khi chạy local. KHÔNG commit .env hoặc secret thật.

# 1. MICROSOFT ENTRA ID / MICROSOFT GRAPH
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_app_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_value_here

# Tùy chọn: code/common/sharepoint_bootstrap.py sẽ tự resolve khi để trống.
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# 2. SHAREPOINT SITE
SHAREPOINT_HOSTNAME=vikodacomvn.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/Planning

# 3. SHAREPOINT FOLDERS
SHAREPOINT_ERP_FOLDER=Data ERP
SHAREPOINT_TARGET_FOLDER=Target
SHAREPOINT_CUSTOMER_FOLDER=Danh muc KH
SHAREPOINT_PRODUCT_FOLDER=Danh muc SP
SHAREPOINT_DATA_GOC_FOLDER=Data_Goc

# 4. LOCAL WINDOWS FALLBACK (OPTIONAL)
# Chỉ dùng khi muốn chạy watcher PowerShell trên máy Windows qua thư mục OneDrive Sync.
# setx VIKODA_ONEDRIVE_PATH "D:\onedrive\Vikoda\Planning - Vikoda_Sales_Data"
